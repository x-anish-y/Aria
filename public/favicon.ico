<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" fill="none">
  <defs>
    <radialGradient id="auraGlow" cx="50%" cy="40%" r="50%">
      <stop offset="0%" stop-color="#f2ca50" stop-opacity="0.9"/>
      <stop offset="45%" stop-color="#10b981" stop-opacity="0.7"/>
      <stop offset="85%" stop-color="#064e3b" stop-opacity="0.9"/>
      <stop offset="100%" stop-color="#05110b" stop-opacity="1"/>
    </radialGradient>
    <filter id="blurHalo" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="3" result="blur"/>
      <feComposite in="SourceGraphic" in2="blur" operator="over"/>
    </filter>
  </defs>

  <!-- Background disc -->
  <rect width="64" height="64" rx="16" fill="#05110b"/>
  
  <!-- Bioluminescent glowing orb -->
  <circle cx="32" cy="32" r="22" fill="url(#auraGlow)" filter="url(#blurHalo)"/>
  
  <!-- Delicate golden hairline orbital ring -->
  <circle cx="32" cy="32" r="25" stroke="#f2ca50" stroke-width="1.2" stroke-opacity="0.5" stroke-dasharray="8 4"/>

  <!-- Botanical A Monogram -->
  <path d="M32 18 L41 38 L37.5 38 L34.5 31 L29.5 31 L26.5 38 L23 38 Z M32 23.5 L30.3 28.5 L33.7 28.5 Z" fill="#ffffff" fill-opacity="0.95"/>
  <circle cx="32" cy="18" r="2" fill="#f2ca50"/>
</svg>
