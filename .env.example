# ==============================================================================
# Aria — AI Voice Support Agent for Aura Skincare
# Environment Variables Template
# Copy this file to .env.local: cp .env.example .env.local
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Neon Serverless Postgres Database
# ------------------------------------------------------------------------------
# Connection string from your Neon console (https://console.neon.tech).
# Use the pooled connection string (with ?sslmode=require) for serverless environments.
# To provision tables and seed initial mock orders (ORD-101, ORD-102, ORD-103):
#   npm run db:setup
DATABASE_URL=postgresql://[user]:[password]@[endpoint]-pooler.[region].aws.neon.tech/neondb?sslmode=require

# ------------------------------------------------------------------------------
# 2. Google Gemini API (Server-side ONLY — Never exposed to browser bundle)
# ------------------------------------------------------------------------------
# Obtain from Google AI Studio: https://aistudio.google.com/app/apikey
# Used to mint ephemeral single-session client tokens via /api/token
GEMINI_API_KEY=your-gemini-api-key-here

# Live Multimodal Audio Model for real-time bidirectional WebSocket voice streaming
# Required for low-latency voice, natural turn-taking, and instantaneous barge-in
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025

# Fast Structured Output Text Model for post-call summaries, sentiment analysis, and QA
GEMINI_SUMMARY_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 3. Groq API (Fallback Voice Mode)
# ------------------------------------------------------------------------------
# Obtain from Groq Console: https://console.groq.com/keys
# Used for ultra-fast text inference (<300ms TTFT) when Gemini Live is unavailable
# or when running in classic fallback mode (Web Speech API + Groq + ElevenLabs/TTS)
GROQ_API_KEY=your-groq-api-key-here

# Model identifier on Groq (e.g., openai/gpt-oss-120b, llama-3.3-70b-versatile)
GROQ_MODEL=openai/gpt-oss-120b

# ------------------------------------------------------------------------------
# 4. Client-Exposed Environment Variables (Prefixed with NEXT_PUBLIC_)
# ------------------------------------------------------------------------------
# Canonical application URL used for OpenGraph cards, absolute links, and CORS
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional test flag: Set to "1" to force the client into classic fallback mode
# NEXT_PUBLIC_FORCE_CLASSIC=0
